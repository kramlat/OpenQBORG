[configuration]
entry_symbol = "openqborg_media_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.x86_64 = "bin/libopenqborg_media.linux.x86_64.so"
linux.arm64 = "bin/libopenqborg_media.linux.arm64.so"
windows.x86_64 = "bin/libopenqborg_media.windows.x86_64.dll"
macos = "bin/libopenqborg_media.macos.arm64.dylib"

[dependencies]
; The LGPL FFmpeg bundled by tools/build-media-ext.sh --lgpl, found via $ORIGIN.
linux.x86_64 = {
	"bin/libavformat.so.62" : "",
	"bin/libavcodec.so.62" : "",
	"bin/libswresample.so.6" : "",
	"bin/libswscale.so.9" : "",
	"bin/libavutil.so.60" : ""
}
